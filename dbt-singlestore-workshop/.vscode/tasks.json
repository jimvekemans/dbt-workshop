{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Workshop cluster",
            "type": "shell",
            "command": "SCRIPT=\"${workspaceFolder}/../infrastructure/workshop.sh\"; if [ -x \"$SCRIPT\" ] && command -v docker >/dev/null; then exec \"$SCRIPT\" session; else echo \"Workshop cluster script or docker not available, skipping\"; fi",
            "options": {
                "shell": {
                    "executable": "bash",
                    "args": ["-c"]
                }
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            }
        },
        {
            "label": "Compile fresh artifacts",
            "type": "shell",
            "command": "dbt clean && CURRENT_BRANCH=$(git branch --show-current) && git fetch origin dev && git stash --include-untracked && MERGE_BASE=$(git merge-base $CURRENT_BRANCH origin/dev) && git checkout $MERGE_BASE && dbt compile --no-partial-parse --target run --target-path artifacts && git switch \"$CURRENT_BRANCH\" && git stash pop"
        },
        {
            "label": "Build modified",
            "type": "shell",
            "command": "dbt build -s state:modified --defer --state artifacts"
        },
        {
            "label": "List modified",
            "type": "shell",
            "command": "dbt ls -s state:modified --state artifacts --output json --output-keys database name resource_type"
        },
        {
            "label": "List all CI pipeline targets",
            "type": "shell",
            "command": "dbt clean && CURRENT_BRANCH=$(git branch --show-current) && git fetch origin dev && git stash --include-untracked && MERGE_BASE=$(git merge-base $CURRENT_BRANCH origin/dev) && git checkout $MERGE_BASE && dbt compile --no-partial-parse --target run --target-path artifacts && git switch \"$CURRENT_BRANCH\" && git stash pop && dbt ls -s state:modified+,+state:modified state:modified+1 --state artifacts --output json --output-keys database name resource_type"
        },
        {
            "label": "Replicate CI pipeline locally",
            "type": "shell",
            "command": "dbt clean && CURRENT_BRANCH=$(git branch --show-current) && git fetch origin dev && git stash --include-untracked && MERGE_BASE=$(git merge-base $CURRENT_BRANCH origin/dev) && git checkout $MERGE_BASE && dbt compile --no-partial-parse --target run --target-path artifacts && git switch \"$CURRENT_BRANCH\" && git stash pop && SCHEMA=\"${CURRENT_BRANCH//[\/-]/_}\" && dbt build -s state:modified+,+state:modified state:modified+1 --state artifacts --target ci --empty --vars \"SCHEMA: ${SCHEMA}\""
        },
        {
            "label": "Rebase feature branch",
            "type": "shell",
            "command": "CURRENT_BRANCH=$(git branch --show-current); if [ \"$CURRENT_BRANCH\" = \"dev\" ]; then echo \"Switch to feature branch before rebasing\"; exit 1; fi; if printf '%s' \"$CURRENT_BRANCH\" | grep -q 'INTEL-'; then git fetch origin dev && if ! git rebase origin/dev; then echo \"Merge conflicts during rebase, manual resolution required\"; git diff --name-only --diff-filter=U; exit 1; fi && if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then git push --force-with-lease; else git push --set-upstream origin \"$CURRENT_BRANCH\"; fi; else echo \"Current branch does not contain INTEL-\"; exit 1; fi"
        },
    ]
}