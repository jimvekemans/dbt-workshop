{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "dbt wrapper",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "/usr/app/dbt/python/dbt_wrapper.py",
            "args": ["${command:pickArgs}"],
            "env": {
                "DBT_DEPLOY_TARGET": "LDV"
            },
            "justMyCode": false
        },
        {
            "name": "Download from SingleStore",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "/usr/app/dbt/python/scripts/download_from_singlestore.py",
            "args": ["${command:pickArgs}"],
            "env": {
                "DBT_DEPLOY_TARGET": "LDV"
            },
            "justMyCode": true
        },
        {
            "name": "Rewrite all sources",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "/usr/app/dbt/python/scripts/update_source_files.py",
            "env": {
                "DBT_DEPLOY_TARGET": "LDV"
            },
            "justMyCode": true
        },
        {
            "name": "Add source",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "/usr/app/dbt/python/scripts/add_source.py",
            "args": ["${command:pickArgs}"],
            "env": {
                "DBT_DEPLOY_TARGET": "LDV"
            },
            "justMyCode": true
        },
        {
            "name": "Analyse ticket status merged branches",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "/usr/app/dbt/python/scripts/analyse_ticket_status_merged_branches.py",
            "args": ["--compare", "origin/main", "--to", "origin/dev", "--fixversion", "2026_DROP07"],
            "justMyCode": true
        }
    ]
}