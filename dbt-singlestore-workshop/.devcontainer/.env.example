# Copy to .env, or let post_create.sh write it. .env is gitignored.
# The SingleStore password can come from two places. Use one of them.
SINGLESTORE_HOST=singlestore
SINGLESTORE_USER=pu_dev1
SINGLESTORE_DB=dev_edw_dv_rdv
DBT_DEPLOY_TARGET=dev

# Way 1 (the default): the password is written in this file.
SINGLESTORE_PASS=

# Way 2: the password is not in any file. The toolbox (vdp, installed as `dbt`) logs in to the workshop vault
# (http://vault:8200 on workshop_net) with the two AppRole ids below and fetches it when a command starts.
# Remove the SINGLESTORE_PASS line above (or leave it empty), uncomment these two and use the ids of YOUR account:
#   pu_dev1 -> workshop-role-id-pu_dev1 / workshop-secret-id-pu_dev1   (same pattern for pu_dev2, pu_dev3)
# These are workshop values for a practice stack. The ids take precedence over SINGLESTORE_PASS from this file.
# KEYVAULT_ROLE_ID=workshop-role-id-pu_dev1
# KEYVAULT_SECRET_ID=workshop-secret-id-pu_dev1
# Check where the password comes from, without printing it: `vdp env show`
